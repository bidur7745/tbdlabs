
PORT=5000
NODE_ENV=development


API_PREFIX=/api
FRONTEND_URL=http://localhost:5173


DATABASE_URL=postgresql://[user]:[password]@[endpoint-id].pooler.[region].aws.neon.tech/[dbname]?sslmode=require
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d


SUPERADMIN_NAME=TBD Labs Superadmin
SUPERADMIN_EMAIL=admin@tbdlabs.com.np
SUPERADMIN_PASSWORD=ChangeThisPassword123!


SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@tbdlabs.com.np
SMTP_PASS=your_app_specific_password_or_api_key
EMAIL_FROM="TBD Labs" <contact@tbdlabs.com.np>



RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CONTACT_RATE_LIMIT_MAX=5
TRUST_PROXY=false
